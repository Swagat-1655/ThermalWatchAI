# ThermalWatch AI — server secrets template
# Copy this file to `.env` and fill in your keys. `.env` is git-ignored and
# must NEVER be committed. Real environment variables (hosting dashboard,
# CI, `FIRMS_API_KEY=xxx npm start`) always override values from this file.

# Groq API key — https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# NASA FIRMS MAP_KEY (free) — https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_API_KEY=your_nasa_map_key_here
